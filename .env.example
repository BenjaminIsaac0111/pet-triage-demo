# Copy to .env and adjust. All settings are optional.
TRIAGE_MODEL=qwen2.5:7b
TRIAGE_TEMPERATURE=0
TRIAGE_PROMPT_VERSION=v2
# Before dismissing a red flag, re-ask this many times at this temperature (0 = off).
TRIAGE_LIFT_CHECK_SAMPLES=4
TRIAGE_LIFT_CHECK_TEMPERATURE=0.8
