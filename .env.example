# Copy to .env and adjust. All settings are optional. .env is git-ignored,
# so API keys you put there stay on your machine.

# --- Which model ---
# ollama (default, local), openai (or any OpenAI-compatible server), anthropic
TRIAGE_PROVIDER=ollama
TRIAGE_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434

# Your own API instead (uncomment one block):
# TRIAGE_PROVIDER=anthropic
# TRIAGE_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# TRIAGE_PROVIDER=openai
# TRIAGE_MODEL=<model name>
# OPENAI_API_KEY=

# Your own local server with an OpenAI-compatible API (LM Studio, vLLM, ...):
# TRIAGE_PROVIDER=openai
# TRIAGE_MODEL=<model name as the server lists it>
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=not-needed

# --- Behaviour ---
TRIAGE_TEMPERATURE=0
TRIAGE_PROMPT_VERSION=v2
# Before dismissing a red flag, re-ask this many times at this temperature (0 = off).
TRIAGE_LIFT_CHECK_SAMPLES=4
TRIAGE_LIFT_CHECK_TEMPERATURE=0.8
# Seconds to wait for each LLM call before giving up.
TRIAGE_TIMEOUT_SEC=120

# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
